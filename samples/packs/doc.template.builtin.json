{
  "packId": "doc.template.builtin",
  "kind": "template",
  "name": "核心文书模板（内置）",
  "engineApi": "doc-template/1",
  "vendor": "本系统内置",
  "scope": "general",
  "description": "门（急）诊病历 / 入院记录 / 产科门诊病历；含 5 个医学表达式控件（BMI、体表面积、平均动脉压、年龄、孕周）",
  "items": [
    {
      "itemType": "expression",
      "itemId": "expr.bmi",
      "name": "体质指数（BMI）",
      "unit": "kg/m²",
      "enabled": true,
      "description": "体重(kg) ÷ 身高(m)²，保留一位小数",
      "expression": {
        "kind": "fn",
        "name": "round",
        "args": [
          {
            "kind": "fn",
            "name": "div",
            "args": [
              {
                "kind": "slot",
                "key": "weightKg"
              },
              {
                "kind": "fn",
                "name": "pow",
                "args": [
                  {
                    "kind": "fn",
                    "name": "div",
                    "args": [
                      {
                        "kind": "slot",
                        "key": "heightCm"
                      },
                      {
                        "kind": "num",
                        "value": 100
                      }
                    ]
                  },
                  {
                    "kind": "num",
                    "value": 2
                  }
                ]
              }
            ]
          },
          {
            "kind": "num",
            "value": 1
          }
        ]
      }
    },
    {
      "itemType": "expression",
      "itemId": "expr.bsa",
      "name": "体表面积（Du Bois 公式）",
      "unit": "m²",
      "enabled": true,
      "description": "0.007184 × 身高(cm)^0.725 × 体重(kg)^0.425，保留三位小数",
      "expression": {
        "kind": "fn",
        "name": "round",
        "args": [
          {
            "kind": "fn",
            "name": "mul",
            "args": [
              {
                "kind": "num",
                "value": 0.007184
              },
              {
                "kind": "fn",
                "name": "pow",
                "args": [
                  {
                    "kind": "slot",
                    "key": "heightCm"
                  },
                  {
                    "kind": "num",
                    "value": 0.725
                  }
                ]
              },
              {
                "kind": "fn",
                "name": "pow",
                "args": [
                  {
                    "kind": "slot",
                    "key": "weightKg"
                  },
                  {
                    "kind": "num",
                    "value": 0.425
                  }
                ]
              }
            ]
          },
          {
            "kind": "num",
            "value": 3
          }
        ]
      }
    },
    {
      "itemType": "expression",
      "itemId": "expr.map",
      "name": "平均动脉压（MAP）",
      "unit": "mmHg",
      "enabled": true,
      "description": "(收缩压 + 2×舒张压) ÷ 3，保留一位小数",
      "expression": {
        "kind": "fn",
        "name": "round",
        "args": [
          {
            "kind": "fn",
            "name": "div",
            "args": [
              {
                "kind": "fn",
                "name": "add",
                "args": [
                  {
                    "kind": "slot",
                    "key": "sbp"
                  },
                  {
                    "kind": "fn",
                    "name": "mul",
                    "args": [
                      {
                        "kind": "num",
                        "value": 2
                      },
                      {
                        "kind": "slot",
                        "key": "dbp"
                      }
                    ]
                  }
                ]
              },
              {
                "kind": "num",
                "value": 3
              }
            ]
          },
          {
            "kind": "num",
            "value": 1
          }
        ]
      }
    },
    {
      "itemType": "expression",
      "itemId": "expr.age",
      "name": "年龄（周岁）",
      "unit": "岁",
      "enabled": true,
      "description": "按患者出生日期与就诊时间计算，**只依赖上下文、不依赖填写项**",
      "expression": {
        "kind": "fn",
        "name": "ageYears",
        "args": [
          {
            "kind": "ctx",
            "key": "patient.birthDate"
          },
          {
            "kind": "ctx",
            "key": "encounter.admittedAt"
          }
        ]
      }
    },
    {
      "itemType": "expression",
      "itemId": "expr.gestationalWeeks",
      "name": "孕周",
      "unit": "周",
      "enabled": true,
      "description": "（就诊时间 − 末次月经）的整周数 —— 产科专科控件",
      "expression": {
        "kind": "fn",
        "name": "weeksBetween",
        "args": [
          {
            "kind": "slot",
            "key": "lmpDate"
          },
          {
            "kind": "ctx",
            "key": "encounter.admittedAt"
          }
        ]
      }
    },
